# Copy to .env.local for local dev. In production, set these as Vercel
# environment variables — never commit real values, never paste them into chat.

# --- Database (Neon / Supabase Postgres connection string) ---
DATABASE_URL="postgresql://user:password@host:5432/marginsnap?sslmode=require"

# --- Etsy (from etsy.com/developers/your-apps, once the Seller App is registered) ---
ETSY_KEYSTRING=""
ETSY_SHARED_SECRET=""

# --- Token encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") ---
TOKEN_ENCRYPTION_KEY=""

# --- Auth (NextAuth) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # generate with: openssl rand -base64 32
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="MarginSnap <hello@marginsnap.app>"

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID="" # the $5-9/mo price you create in Stripe (Blueprint decision)

# --- Cron auth (Vercel sets the Authorization header to this automatically once set) ---
CRON_SECRET=""
