// MarginSnap — Prisma schema
// Matches the data model in the Blueprint (§4), plus the auth tables NextAuth's
// Prisma adapter needs. `marketplace` on Shop is the hook for expanding beyond
// Etsy later (see Blueprint §3/§Architecture) — everything else assumes Etsy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
   url      = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

// ---------- Auth (NextAuth / Auth.js — email magic link) ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  createdAt     DateTime  @default(now())

  // Billing
  stripeCustomerId     String?   @unique
  // "active" is the only status meaning "currently paying" — see
  // src/lib/billing.ts. "trialing" is unused going forward: the free trial
  // below is our own, not Stripe's (no card collected up front, Bogdan's
  // call 2026-09-17), so no Stripe subscription/customer exists at all
  // until someone actually checks out.
  subscriptionStatus   String?   // e.g. "active" | "past_due" | "canceled"
  subscriptionPriceId  String?

  // Free trial (2026-09-17, Bogdan's request): 30 days from account
  // creation — NOT from connecting Etsy — so a slow signup can't quietly
  // extend it. Set once, in auth.ts's events.createUser. Null only for
  // accounts that existed before this shipped (grandfathered — never
  // gated, see src/lib/billing.ts's getBillingStatus).
  trialEndsAt DateTime?
  // Which of the countdown-email stages (14/10/7/5/3/1 days left) have
  // already been sent, as their day-count strings — see
  // src/app/api/cron/trial-reminders/route.ts. Prevents double-sending if
  // that cron ever runs twice in a day.
  trialReminderStagesSent String[] @default([])
  // Last time the post-trial "still want MarginSnap?" nag went out —
  // repeated every ~3 weeks for as long as the trial's over and they
  // haven't subscribed. Null = never sent one yet.
  lastRenewalReminderAt DateTime?

  accounts Account[]
  sessions Session[]
  shops    Shop[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------- Product data (Blueprint §4) ----------

model Shop {
  id          String   @id @default(cuid())
  userId      String
  marketplace String   @default("etsy") // hook for a second marketplace later — see Blueprint §Architecture

  etsyShopId  BigInt?
  shopName    String?

  // Fee-engine inputs (feeEngine.ts computeOrderFees) — per-shop, since every
  // connected shop can be a different seller in a different country.
  //
  // sellerCountry: ISO 3166-1 alpha-2, pulled from Etsy's own
  // shop_location_country_iso every sync (syncShop) — never entered by hand,
  // never assumed. Null until the first successful sync.
  sellerCountry String?
  // sellerHasValidVatId: Etsy's API has no field for this anywhere (checked
  // the full Shop resource — nothing tax/VAT-related is exposed), so it's the
  // one fee-engine input each seller sets themselves, on /dashboard/settings.
  // Defaults to false (the conservative assumption — this slightly overstates
  // fees rather than understates profit for a seller who has a VAT ID but
  // hasn't told us yet).
  sellerHasValidVatId Boolean @default(false)

  // assumeShippingNetZero: the shop-level default for how shipping is treated
  // in profit math (src/lib/profitability.ts). Etsy's API has no field for
  // what a seller actually paid for postage — only what they charged the
  // buyer (Order.shippingCost). Most sellers don't charge buyers exactly
  // what postage costs them, so the conservative default is false: treat
  // shipping revenue as real revenue, and require a real
  // Order.shippingCostAtSale before counting it as a cost — never assume it
  // nets to zero. A seller who deliberately charges buyers their exact
  // postage cost (making it a real net-zero line) can flip this on here;
  // the dashboard also has a view-only quick toggle that previews the other
  // mode without changing this stored default. See PROJECT.md.
  assumeShippingNetZero Boolean @default(false)

  // Encrypted at rest by the app layer before being written here — never store plaintext tokens.
  accessTokenEnc  String? @db.Text
  refreshTokenEnc String? @db.Text
  tokenExpiresAt  DateTime?

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  // First-time onboarding wizard (2026-09-17): VAT status + shipping
  // net-zero assumption + (for small shops) inline cost entry, shown once
  // right after the first sync produces at least one listing — see
  // src/app/dashboard/onboarding/page.tsx. Null = hasn't seen it yet.
  // Existing shops are backfilled to "now" in the migration so they never
  // see this retroactively.
  onboardedAt DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings Listing[]
  orders   Order[]

  @@index([userId])
  @@map("shops")
}

model Listing {
  id            String   @id @default(cuid())
  shopId        String
  etsyListingId BigInt
  title         String
  sku           String?
  // cogsAmount removed 2026-09-16 — replaced by CogsEntry below, a dated
  // history of cost-of-goods values (Bogdan's request: mirror Sellerboard's
  // "apply from today / retroactively for all orders / from a specific
  // date"). "The current cost" is now: the CogsEntry with the latest
  // effectiveFrom at or before "now" — see src/lib/cogs.ts's
  // resolveCogsForDate, which sync.ts and the Manage Costs page both use
  // (with "now" swapped for the order's own date, for sync.ts).
  // defaultShippingCost: "what shipping usually costs me for this item" —
  // never charged automatically, just a convenience default. sync.ts seeds a
  // new order's shippingCostAtSale from this ONLY when the order is a
  // single-listing order (so we're never guessing how to split it across
  // different products); a seller can still edit any individual order's
  // real cost afterward when it happened to ship differently (e.g.
  // international). See src/lib/profitability.ts and ShippingCostEditor.
  defaultShippingCost Decimal? @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  shop           Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderLineItems OrderLineItem[]
  cogsEntries    CogsEntry[]
  adSpendEntries AdSpendEntry[]

  @@unique([shopId, etsyListingId])
  @@index([shopId])
  @@map("listings")
}

// Manual per-listing, per-period ad spend (2026-09-17, Bogdan's request) —
// Etsy's public API has no ad-spend endpoint at all (confirmed via
// github.com/etsy/open-api/discussions/1082, an unresolved feature request
// since 2023), and there's no documented CSV export for it in Shop Manager
// either, so this is the seller's own numbers, entered by hand-off two
// paths: pasting the copied table from Etsy's own Ads stats page
// (src/lib/adSpendImport.ts, no AI involved, free) or uploading/pasting a
// screenshot of it (src/lib/adSpendVision.ts, one Anthropic vision call per
// image). Both paths land here through the SAME reviewed-and-confirmed save
// step (src/app/api/ad-spend/save/route.ts) — nothing from either parser is
// ever written straight to the database, since a misread number here
// silently distorts profit. periodStart/periodEnd are whatever the seller
// confirmed on the review screen (auto-detected where possible, always
// editable) — deliberately NOT constrained to match one of the dashboard's
// standard period buckets, since Etsy's own Ads stats page lets sellers
// pick arbitrary date ranges too. Overlap with a given dashboard period
// (not exact containment) is what profitability.ts sums per listing — see
// its comment for why proration wasn't worth the complexity for v1.
//
// @@unique([listingId, periodStart, periodEnd]) (2026-09-17, fixing a
// re-import footgun) makes "the same listing, the exact same period" the
// natural key for one report — re-pasting or re-screenshotting a report you
// already saved corrects that entry's amount instead of quietly adding a
// second one that profitability.ts would then sum on top of the first,
// silently doubling that listing's ad spend. /api/ad-spend/save upserts on
// this key. Two DIFFERENT (even overlapping) periods for the same listing
// are still both kept, on purpose — sellers importing e.g. weekly reports
// inside one dashboard month is the normal case, not a duplicate.
model AdSpendEntry {
  id          String   @id @default(cuid())
  listingId   String
  periodStart DateTime
  periodEnd   DateTime
  amountSpent Decimal  @db.Decimal(10, 2)
  currency    String?
  // "paste" | "screenshot" — which review flow produced this row, kept
  // around for support/debugging, not shown as anything load-bearing in the UI.
  source      String
  createdAt   DateTime @default(now())
  // Bumped by the upsert in /api/ad-spend/save whenever a re-import
  // corrects an existing entry's amount rather than creating a new one —
  // lets "Recently added" show a row as corrected rather than newly added.
  updatedAt   DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, periodStart, periodEnd])
  @@map("ad_spend_entries")
}

// Dated cost-of-goods history for a listing (2026-09-16, replaces the old
// single Listing.cogsAmount column). Setting a new cost is always just
// inserting a row here — the three Sellerboard-style modes Bogdan asked for
// are all the SAME operation, only effectiveFrom differs:
//   - "apply from today":            effectiveFrom = today
//   - "apply retroactively to all":  effectiveFrom = EARLIEST_SENTINEL
//     (src/lib/cogs.ts) — a date old enough to predate every real order, so
//     this entry becomes the fallback for anything with no later entry
//   - "apply from a specific date":  effectiveFrom = that date
// Resolving a listing's cost as of a given date: the entry with the latest
// effectiveFrom at or before that date (resolveCogsForDate). Adding an
// entry never touches already-synced OrderLineItems by itself — recomputing
// their cogsAtSale/lineProfit for orders the new entry now covers is a
// separate, explicit, user-confirmed action (see
// src/app/api/listings/[id]/cogs/route.ts) — the seller sees exactly how
// many orders will change and must confirm before it runs, since (unlike
// the shipping-cost backfill, which only ever fills in a value that was
// never set) this can genuinely overwrite an existing computed value.
model CogsEntry {
  id            String   @id @default(cuid())
  listingId     String
  cogsAmount    Decimal  @db.Decimal(10, 2)
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, effectiveFrom])
  @@map("cogs_entries")
}

model Order {
  id             String   @id @default(cuid())
  shopId         String
  etsyReceiptId  BigInt
  orderDate      DateTime
  grossAmount    Decimal  @db.Decimal(10, 2)
  // ISO 4217, from the real receipt's currency_code (e.g. "EUR", "USD") —
  // never assumed. Nullable only for rows synced before this field existed;
  // the dashboard falls back to a neutral display when it's null.
  currency       String?
  // A FeeEngineBreakdown from feeEngine.ts's computeOrderFees() — itemTotal,
  // shippingTotal, transactionFee, paymentProcessingFee, multiQuantityFee,
  // offsiteAdsFee, currencyConversionFee, regulatoryOperatingFee, vatOnFees,
  // totalFees, netToSeller, ratesUsed. {} when the shop's sellerCountry
  // hasn't synced yet (see syncShop).
  feesBreakdown  Json
  // What the BUYER was charged for shipping (Etsy's total_shipping_cost) —
  // already counted as revenue inside feesBreakdown.orderTotal. Not what the
  // seller paid for postage; see shippingCostAtSale below for that.
  shippingCost   Decimal  @db.Decimal(10, 2) @default(0)
  // What the SELLER actually paid for postage on this order — never
  // fetched from Etsy (no such field exists), only entered by hand on the
  // dashboard (ShippingCostEditor). Null = "not entered yet", never assumed
  // to be 0 or equal to shippingCost — see profitability.ts for how this
  // combines with Shop.assumeShippingNetZero to produce netProfit.
  shippingCostAtSale Decimal? @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  shop      Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  lineItems OrderLineItem[]

  @@unique([shopId, etsyReceiptId])
  @@index([shopId, orderDate])
  @@map("orders")
}

model OrderLineItem {
  id          String   @id @default(cuid())
  orderId     String
  listingId   String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)

  // Resolved at sync time from whichever CogsEntry was effective on this
  // order's date (src/lib/cogs.ts) — NOT simply "whatever the listing's
  // cost is right now" (that was the pre-2026-09-16 behavior, and it was
  // buggier than intended: see PROJECT.md's note on the 90-day resync
  // window silently rewriting recent orders' cost every sync). Only
  // changes after the fact through the explicit, confirmed recompute in
  // src/app/api/listings/[id]/cogs/route.ts — never as a side effect of a
  // plain sync.
  cogsAtSale  Decimal? @db.Decimal(10, 2)
  lineProfit  Decimal? @db.Decimal(10, 2) // null when cogsAtSale is null — "add a cost to see profit"

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([listingId])
  @@map("order_line_items")
}
